<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#202124"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Пранк-окно установки MAX. Только для розыгрыша друзей."
        android:textColor="#5F6368"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="⚠️ Разрешение на вспл. окна не выдано"
        android:textSize="16sp"
        android:textColor="#202124"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitle" />

    <Button
        android:id="@+id/btnRequestPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Дать разрешение"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/txtStatus" />

    <Button
        android:id="@+id/btnStartPrank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Запустить пранк"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/btnRequestPermission" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Как это работает:\n1. Дайте разрешение «Поверх других приложений».\n2. Нажмите «Запустить пранк» и передайте телефон жертве.\n3. Поверх рабочего стола появится «установка MAX» — кнопка «Установить» нажмётся сама.\n\nЗакрыть оверлей: остановите приложение MAX Prank в недавних или выключите экран и обратно."
        android:textSize="13sp"
        android:textColor="#5F6368"
        app:layout_constraintTop_toBottomOf="@id/btnStartPrank" />

</androidx.constraintlayout.widget.ConstraintLayout>
